# Copie este arquivo para .env e preencha os valores no seu computador.
# Nunca envie o .env ao GitHub nem compartilhe chaves secretas.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE_SECRETA

# Se seu projeto só mostrar as chaves antigas, use alternativamente:
# SUPABASE_ANON_KEY=sua_chave_anon_publica
# SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta
